[Unit]
Description=Luminus - Processamento da Fila WhatsApp
Wants=network-online.target
After=network-online.target mariadb.service

[Service]
Type=oneshot
User=cobranca
Group=cobranca
WorkingDirectory=/var/www/cobranca
Environment=NODE_ENV=production
EnvironmentFile=/var/www/cobranca/.env
ExecStart=/usr/bin/flock -n /run/luminus-whatsapp-fila.lock /usr/bin/env pnpm exec tsx scripts/processar-whatsapp-fila.mjs
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true
