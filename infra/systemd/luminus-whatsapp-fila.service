[Unit]
Description=Luminus - Processamento da Fila WhatsApp
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
Type=oneshot
User=cobranca
WorkingDirectory=/var/www/cobranca
EnvironmentFile=/var/www/cobranca/.env
ExecStart=/usr/bin/env pnpm exec tsx scripts/processar-whatsapp-fila.mjs
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true
