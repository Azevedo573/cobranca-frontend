[Unit]
Description=Luminus - Execução da Régua de Cobrança
Wants=network-online.target
After=network-online.target mariadb.service

[Service]
Type=oneshot
User=cobranca
Group=cobranca
WorkingDirectory=/var/www/cobranca
Environment=NODE_ENV=production
EnvironmentFile=/var/www/cobranca/.env
ExecStart=/usr/bin/flock -n /run/luminus-regua.lock /usr/bin/env pnpm exec tsx scripts/executar-regua.mjs
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true
